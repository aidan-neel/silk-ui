{
	"name": "sivir",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.11",
	"engines": {
		"bun": ">=1.3.11"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"overrides": {
		"brace-expansion": "5.0.9",
		"cookie": "1.1.1",
		"fast-uri": "3.1.5",
		"postcss": "8.5.25",
		"prettier": "3.8.3",
		"tar": "7.5.22",
		"undici": "7.28.0"
	},
	"scripts": {
		"dev": "turbo run dev",
		"devnet": "turbo run devnet --filter=docs --filter=installer-lab",
		"build": "turbo run build",
		"generate": "turbo run generate",
		"check": "turbo run check",
		"lint": "turbo run lint",
		"test": "turbo run test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"lefthook": "^1.13.6",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"turbo": "^2.10.0"
	}
}
