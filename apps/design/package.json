{
    "name": "design",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "bun@1.3.11",
    "engines": {
        "bun": ">=1.3.11"
    },
    "scripts": {
        "dev": "vite dev --host 127.0.0.1",
        "build": "vite build",
        "preview": "vite preview --host 127.0.0.1",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "lint": "biome lint .",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@lucide/svelte": "^1.7.0",
        "@sivir-ui/svelte": "workspace:*"
    },
    "devDependencies": {
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.70.2",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@tailwindcss/vite": "^4.2.2",
        "fake-indexeddb": "^6.2.4",
        "svelte": "^5.55.1",
        "svelte-check": "^4.4.6",
        "tailwindcss": "^4.2.2",
        "typescript": "^5.9.3",
        "vite": "^8.0.3",
        "vitest": "^4.1.7"
    },
    "trustedDependencies": [
        "@tailwindcss/oxide",
        "esbuild"
    ]
}
