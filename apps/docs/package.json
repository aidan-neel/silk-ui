{
    "name": "docs",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "packageManager": "bun@1.3.11",
    "engines": {
        "bun": ">=1.3.11"
    },
    "scripts": {
        "dev": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js dev",
        "devnet": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js dev --host 0.0.0.0",
        "build": "bunx --bun vite build",
        "preview": "bunx --bun vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "format": "biome format --write .",
        "lint": "biome lint .",
        "test": "bun run test:ci",
        "test:all": "vitest run",
        "test:ci": "vitest run --project unit --project ssr",
        "test:browser": "vitest run --project browser --project browser-reduced",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@sveltejs/adapter-node": "^5.3.2",
        "@sveltejs/adapter-vercel": "^6.3.4",
        "@sveltejs/kit": "^2.70.2",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@tailwindcss/vite": "^4.2.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/svelte": "^5.3.1",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^22.0.0",
        "@vitest/browser": "^4.1.7",
        "@vitest/browser-playwright": "^4.1.7",
        "axe-core": "^4.11.4",
        "jsdom": "^29.1.1",
        "motion": "^12.38.0",
        "playwright": "^1.60.0",
        "shiki": "^4.0.2",
        "svelte": "^5.55.1",
        "svelte-check": "^4.4.6",
        "tailwindcss": "^4.2.2",
        "typescript": "^5.9.3",
        "vite": "^8.0.3",
        "vitest": "^4.1.7",
        "vitest-browser-svelte": "^2.1.1"
    },
    "dependencies": {
        "@floating-ui/dom": "^1.7.6",
        "@sivir-ui/svelte": "workspace:*",
        "@lucide/svelte": "^1.7.0",
        "@vercel/analytics": "^2.0.1",
        "clsx": "^2.1.1",
        "mode-watcher": "^1.1.0",
        "svelte-persisted-state": "^1.4.0",
        "tailwind-variants": "^3.2.2"
    },
    "trustedDependencies": [
        "@tailwindcss/oxide",
        "esbuild"
    ]
}
